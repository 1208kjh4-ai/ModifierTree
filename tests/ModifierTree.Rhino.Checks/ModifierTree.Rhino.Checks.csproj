<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">C:\Program Files\Rhino 8\System</RhinoSystemDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ModifierTree.Core\ModifierTree.Core.csproj" />
    <!-- CoreCLR's startup assembly list rejects .rhp extensions. Compile the same
         production services into the headless harness; plugin metadata is checked separately. -->
    <Compile Include="..\..\src\ModifierTree.Rhino\Modifiers\*.cs" Link="Production\Modifiers\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\ModifierTree.Rhino\Persistence\*.cs" Link="Production\Persistence\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\ModifierTree.Rhino\Display\PreviewAppearance.cs" Link="Production\Display\PreviewAppearance.cs" />
    <Compile Include="..\..\src\ModifierTree.Rhino\UI\ManagerLayout.cs" Link="Production\UI\ManagerLayout.cs" />
    <Compile Include="..\..\src\ModifierTree.Rhino\UI\TreeGridSelection.cs" Link="Production\UI\TreeGridSelection.cs" />
    <Compile Include="..\..\src\ModifierTree.Rhino\UI\ModifierPropertiesEditor.cs" Link="Production\UI\ModifierPropertiesEditor.cs" />
    <Reference Include="Eto"><HintPath>$(RhinoSystemDir)\Eto.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Eto.Wpf"><HintPath>$(RhinoSystemDir)\Eto.Wpf.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\netcore\RhinoCommon.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
</Project>
